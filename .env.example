# ── LinkedIn OAuth (required for "Sign in with LinkedIn" feature) ──────────
# Create an app at: https://www.linkedin.com/developers/apps/new
# Add redirect URL: http://localhost:8000/api/auth/linkedin/callback
# Enable scopes: openid, profile, email
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# OAuth redirect URI (must match what you set in LinkedIn Developer Console)
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/auth/linkedin/callback

# Frontend URL (where the SPA is served — used for post-OAuth redirect)
FRONTEND_URL=http://localhost:5173

# ── App ────────────────────────────────────────────────────────────────────
APP_SECRET_KEY=change-me-to-a-random-secret-in-production
