# ── LinkedIn OAuth (required for "Sign in with LinkedIn" feature) ──────────
# Create an app at: https://www.linkedin.com/developers/apps/new
# Required OAuth 2.0 scopes: openid, profile, email
#
# For local dev, add redirect URL:
#   http://localhost:8000/api/auth/linkedin/callback
#
# For Vercel production, add redirect URL:
#   https://<your-project>.vercel.app/api/auth/linkedin/callback

LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here

# Must match the redirect URL added in LinkedIn Developer Console
LINKEDIN_REDIRECT_URI=https://<your-project>.vercel.app/api/auth/linkedin/callback

# Frontend URL used for post-OAuth redirect
# Local:      http://localhost:5173
# Production: https://<your-project>.vercel.app
FRONTEND_URL=https://<your-project>.vercel.app

# App secret (used for session tokens — change in production)
APP_SECRET_KEY=change-me-to-a-random-secret-in-production
